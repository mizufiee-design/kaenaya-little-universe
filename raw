
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Kaenaya's Little Universe ♡</title>

<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  background: #101225;
  color: #f5efff;
  font-family: Georgia, serif;
  min-height: 100vh;
  overflow-x: hidden;
}

#stars {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 0;
}

.star {
  position: absolute;
  background: white;
  border-radius: 50%;
  animation: twinkle 3s infinite alternate;
}

@keyframes twinkle {
  from { opacity: .2; }
  to { opacity: 1; }
}

main {
  position: relative;
  z-index: 1;
  max-width: 850px;
  margin: auto;
  padding: 25px 20px 60px;
}

header {
  text-align: center;
  padding: 90px 10px 65px;
}

.eyebrow {
  color: #b9a6e9;
  letter-spacing: 4px;
  font-size: 11px;
}

h1 {
  font-size: clamp(40px, 10vw, 70px);
  margin: 20px 0 8px;
  font-weight: normal;
  color: #e5d8ff;
}

.subtitle {
  color: #b9b4ce;
  font-size: 14px;
  line-height: 1.8;
}

.saturn {
  font-size: 75px;
  margin: 25px 0;
  animation: float 5s ease-in-out infinite;
}

@keyframes float {
  50% { transform: translateY(-14px) rotate(8deg); }
}

button {
  border: 1px solid #a99ad0;
  color: #f5efff;
  background: #383253;
  padding: 13px 23px;
  border-radius: 30px;
  cursor: pointer;
  font-size: 13px;
  margin-top: 22px;
}

button:hover {
  background: #554778;
}

nav {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 9px;
  margin-bottom: 45px;
}

nav button {
  margin: 0;
  padding: 10px 15px;
}

section {
  display: none;
  padding: 28px 22px;
  border: 1px solid #484261;
  border-radius: 20px;
  background: rgba(35, 34, 61, .85);
  margin-bottom: 25px;
  animation: appear .5s ease;
}

section.active {
  display: block;
}

@keyframes appear {
  from { opacity: 0; transform: translateY(12px); }
  to { opacity: 1; transform: translateY(0); }
}

h2 {
  color: #d9c9ff;
  font-size: 27px;
  font-weight: normal;
  margin-bottom: 18px;
}

p {
  color: #d0cadd;
  line-height: 1.9;
  font-size: 14px;
}

.card {
  padding: 18px;
  background: #302d4c;
  border-radius: 14px;
  margin-top: 13px;
}

.card h3 {
  color: #e3d6ff;
  font-size: 17px;
  margin-bottom: 8px;
  font-weight: normal;
}

footer {
  text-align: center;
  color: #9189a9;
  font-size: 11px;
  padding: 35px 10px;
}
</style>
</head>

<body>
<div id="stars"></div>

<main>
<header>
  <div class="eyebrow">A LITTLE PLACE IN THE UNIVERSE</div>
  <div class="saturn">🪐</div>
  <h1>Kaenaya's<br>Little Universe</h1>
  <p class="subtitle">
    a universe made of little things,<br>
    memories, and her.
  </p>
  <button onclick="showPage('home')">
    explore her universe ✦
  </button>
</header>

<nav>
  <button onclick="showPage('home')">Home</button>
  <button onclick="showPage('about')">About her</button>
  <button onclick="showPage('favorites')">Her orbit</button>
  <button onclick="showPage('memories')">Memories</button>
  <button onclick="showPage('letters')">Letters</button>
</nav>

<section id="home" class="active">
  <h2>Welcome, Kaenaya ♡</h2>
  <p>
    Somewhere in this endless universe,
    there's a little world made especially
    to celebrate all the little things about you.
  </p>
  <div class="card">
    <h3>✦ a little reminder</h3>
    <p>
      You don't have to be extraordinary
      every day. Just being yourself is
      already something beautiful.
    </p>
  </div>
</section>

<section id="about">
  <h2>Meet the girl 🌙</h2>
  <p>
    A little introduction to someone
    whose existence makes this universe
    a little more interesting.
  </p>
  <div class="card">
    <h3>Her name</h3>
    <p>Kaenaya ♡</p>
  </div>
  <div class="card">
    <h3>Her little universe</h3>
    <p>
      Full of stories, little habits,
      dreams, and things that make her unique.
    </p>
  </div>
</section>

<section id="favorites">
  <h2>Her own orbit 🪐</h2>
  <div class="card">
    <h3>🪐 Saturn</h3>
    <p>A little planet in her universe.</p>
  </div>
  <div class="card">
    <h3>🌷 Flowers</h3>
    <p>Lilies and sunflowers.</p>
  </div>
  <div class="card">
    <h3>🎧 Music</h3>
    <p>Beabadoobee and ALD1.</p>
  </div>
  <div class="card">
    <h3>🍫 Little treats</h3>
    <p>Chocolate, cookies, and dimsum mentai.</p>
  </div>
</section>

<section id="memories">
  <h2>Little memories 📷</h2>
  <p>
    This page is waiting for little moments
    worth keeping.
  </p>
  <div class="card">
    <h3>Memory no. 001</h3>
    <p>
      Some moments are small,
      but somehow they stay with us.
    </p>
  </div>
  <p style="margin-top:15px">
    More memories will find their place here.
  </p>
</section>

<section id="letters">
  <h2>Open when... 💌</h2>
  <p>Choose a little letter to open.</p>

  <div class="card">
    <h3>🌧️ When you feel down</h3>
    <button onclick="letter('down')">Open letter</button>
  </div>

  <div class="card">
    <h3>☀️ When you need a smile</h3>
    <button onclick="letter('smile')">Open letter</button>
  </div>

  <div class="card">
    <h3>🌙 Just because</h3>
    <button onclick="letter('always')">Open letter</button>
  </div>

  <div id="letterContent" class="card" style="display:none">
    <p id="letterText"></p>
  </div>
</section>

<footer>
  made of little things, just like her ♡<br>
  kaenaya's little universe · 2026
</footer>
</main>

<script>
function showPage(id) {
  document.querySelectorAll('section').forEach(s => {
    s.classList.remove('active');
  });
  document.getElementById(id).classList.add('active');
  document.getElementById(id).scrollIntoView({
    behavior: 'smooth',
    block: 'start'
  });
}

function letter(type) {
  const messages = {
    down: "Hey, it's okay to have difficult days. Take your time, breathe, and remember that you deserve kindness too. ♡",
    smile: "Here's a little reminder that the world has so many lovely things, and you are one of them. ✨",
    always: "If this little universe could tell you one thing, it would be how special all your little details are. 🌙"
  };

  document.getElementById('letterText').textContent =
    messages[type];

  document.getElementById('letterContent').style.display = 'block';
}

const stars = document.getElementById('stars');

for (let i = 0; i < 100; i++) {
  const star = document.createElement('div');
  star.className = 'star';
  star.style.left = Math.random() * 100 + '%';
  star.style.top = Math.random() * 100 + '%';
  const size = Math.random() * 3 + 1;
  star.style.width = size + 'px';
  star.style.height = size + 'px';
  star.style.animationDelay = Math.random() * 3 + 's';
  stars.appendChild(star);
}
</script>
</body>
</html>
